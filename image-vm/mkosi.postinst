#!/bin/bash
# mkosi post-installation hook. Runs on the host with the image root at $BUILDROOT (mkosi >= 24;
# in v20 it ran inside the chroot — then export BUILDROOT=/ first).
# Everything here is a build-time fact about an immutable root; runtime state goes to /var.
set -euo pipefail
R="${BUILDROOT:?BUILDROOT must point at the image root}"
[ -f "$R/usr/lib/os-release" ] || { echo "not an image root: $R" >&2; exit 1; }

# Debian installs the kernel as /boot/vmlinuz-<ver>; mkosi builds the UKI from /usr/lib/modules/<ver>/vmlinuz.
for m in "$R"/usr/lib/modules/*/; do
    v=$(basename "$m")
    [ -e "$m/vmlinuz" ] || [ ! -e "$R/boot/vmlinuz-$v" ] || cp "$R/boot/vmlinuz-$v" "$m/vmlinuz"
done

# /home, /srv, /opt live on /var (root is read-only). tmpfiles creates /var/{home,srv,opt} at boot.
for d in home srv opt; do
    if [ -d "${R:?}/${d:?}" ] && [ ! -L "${R:?}/${d:?}" ]; then
        rmdir "${R:?}/${d:?}"      # refuses if non-empty: a populated /home in the image is a build error
    fi
    ln -sfn "var/$d" "${R:?}/${d:?}"
done

# sysupdate source names carry the GPT root type: root-x86-64 in the shipped transfers; arm64 (rpi4) → root-arm64.
case "${ARCHITECTURE:-x86-64}" in
    x86-64) ;;
    arm64) sed -i 's/\.root-x86-64\(-verity\)\?\.raw$/.root-arm64\1.raw/' "$R"/usr/lib/sysupdate.d/*.transfer ;;
    *) echo "mkosi.postinst: no sysupdate naming for architecture $ARCHITECTURE" >&2; exit 1 ;;
esac

# resolv.conf → systemd-resolved stub (the symlink itself is on the ro root, the target in /run).
ln -sfn ../run/systemd/resolve/stub-resolv.conf "$R/etc/resolv.conf"

# Lock root; the only human path in is ssh key → owner → sudo (README "break-glass").
sed -i 's|^root:[^:]*:|root:!:|' "$R/etc/shadow" || true

# machine-id is assigned on first boot and persisted into the /etc overlay (etc-overlay.sh).
: > "$R/etc/machine-id"

# Record the policy hash so `why /etc/resident/policy.toml` has a fixed answer per image.
mkdir -p "$R/usr/share/resident"
sha256sum "$R/etc/resident/policy.toml" | cut -c1-16 > "$R/usr/share/resident/policy.sha256"

# agentd's runtime ships in the read-only image: a venv with the pinned Claude Agent SDK (which bundles the
# Claude Code CLI). Installed OFFLINE from wheels staged in usr/lib/resident/wheels, so builds are reproducible;
# the wheels are removed afterwards. Re-stage them with:  ./stage-wheels.sh
W="$R/usr/lib/resident/wheels"
if [ -d "$W" ]; then
    mkosi-chroot python3 -m venv /usr/lib/resident/agentd/venv
    mkosi-chroot /usr/lib/resident/agentd/venv/bin/pip install --no-index --no-cache-dir --disable-pip-version-check \
        --find-links /usr/lib/resident/wheels "claude-agent-sdk==0.2.174"
    rm -rf "${W:?}"
fi
