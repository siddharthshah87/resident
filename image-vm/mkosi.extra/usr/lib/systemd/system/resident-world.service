[Unit]
Description=resident: regenerate machine.md and record drift
After=resident-firstboot.service
Wants=resident-firstboot.service

[Service]
Type=oneshot
# Bookkeeping must see the whole machine (polkit's rules.d is 0700): run as root, but write the shared
# record as group agent (umask 0002) so agentd can keep updating it. agentd itself stays unprivileged.
Group=agent
UMask=0002
Environment=RESIDENT_HOME=/var/lib/resident RESIDENT_AUTHOR=system HOME=/var/lib/resident
ExecStart=/usr/lib/resident/agentos.py world
StandardOutput=null
ProtectSystem=strict
ReadWritePaths=/var/lib/resident
PrivateTmp=yes
NoNewPrivileges=yes
