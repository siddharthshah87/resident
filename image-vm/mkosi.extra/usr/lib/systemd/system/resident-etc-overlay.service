[Unit]
Description=resident: persistent writable /etc (overlayfs upper on /var; root stays verity-sealed)
Documentation=file:///usr/share/doc/resident/README.md
DefaultDependencies=no
RequiresMountsFor=/var
After=var.mount systemd-remount-fs.service
# Not Before=systemd-sysusers: tmpfiles-setup-dev runs after sysusers and udev waits for it, so that
# ordering deadlocks /var (device → udev → tmpfiles-setup-dev → sysusers → this → /var). Users are baked at build.
Before=local-fs.target systemd-machine-id-commit.service
ConditionPathIsReadWrite=!/etc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/resident/etc-overlay.sh

[Install]
WantedBy=local-fs.target
