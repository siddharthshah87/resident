#!/usr/bin/python3 -I
"""resident-root-apply — run ONE owner-approved Resident proposal as root.

  sudo -n /usr/local/libexec/resident-root-apply <proposal.json>
  resident-root-apply --selftest-config <dir> <proposal.json>     tests only; refused when run as root

Trust: this file is installed root-owned and is SELF-CONTAINED on purpose — it imports nothing from ~/resident
(the agent can write there). It trusts only /etc/resident/owner.json (the owner's passkey PUBLIC key, root-owned)
and /var/lib/resident-root/used (root-owned replay list). It runs the proposal's command only if the stored
WebAuthn assertion is a valid signature by that key over sha256(canonical(proposal)), i.e. the owner approved
exactly this command, verify command and root flag, and only once per (id, nonce).

Exit: the command's exit code; 77 = refused (nothing ran); 124 = command timed out (killed after 300 s).
"""
import base64, fcntl, hashlib, hmac, json, os, re, signal, stat, subprocess, sys
from datetime import datetime, timezone

CONFIG = "/etc/resident/owner.json"
USED_DIR = "/var/lib/resident-root"
LOG = "/var/log/resident-root.log"
TIMEOUT = 300
REFUSED = 77
CANON_FIELDS = ("kind", "id", "requester", "summary", "why", "command", "verify", "root", "nonce")
ID_RE = re.compile(r"[0-9a-f]{6}")
NONCE_RE = re.compile(r"[A-Za-z0-9_-]{22}")
B64_RE = re.compile(r"[A-Za-z0-9_-]*={0,2}")
FLAG_UP, FLAG_UV = 0x01, 0x04
CLEAN_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "HOME": "/root", "USER": "root",
             "LOGNAME": "root", "SHELL": "/bin/sh"}


class Refuse(Exception):
    pass


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def b64d(s, what):
    if not isinstance(s, str) or not s or not B64_RE.fullmatch(s):
        raise Refuse(f"{what} is not base64url")
    s = s.rstrip("=")
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def sha256(b):
    return hashlib.sha256(b).digest()


def canonical(p):
    return json.dumps({k: p[k] for k in CANON_FIELDS}, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def trusted_file(path, strict, want_dir=False):
    """In real (root) mode a trust anchor must be root-owned and not writable by group/other."""
    st = os.lstat(path)
    if want_dir != stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
        raise Refuse(f"{path} is not a {'directory' if want_dir else 'regular file'}")
    if strict and (st.st_uid != 0 or st.st_mode & 0o022):
        raise Refuse(f"{path} must be owned by root and not group/world-writable")


def load_config(path, strict):
    try:
        trusted_file(os.path.dirname(path), strict, want_dir=True)
        trusted_file(path, strict)
        with open(path, "rb") as fh:
            cfg = json.loads(fh.read(65536))
    except Refuse:
        raise
    except (OSError, ValueError):
        raise Refuse(f"cannot read owner key {path} (run install.sh)")
    for k in ("cred_id", "x", "y", "rp_id", "origin"):
        if not isinstance(cfg.get(k), str) or not cfg[k]:
            raise Refuse(f"{path}: {k} missing")
    if cfg["origin"] != "https://" + cfg["rp_id"]:
        raise Refuse(f"{path}: origin does not match rp_id")
    return cfg


def load_proposal(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as e:
        raise Refuse(f"cannot open proposal ({e.strerror})")
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            raise Refuse("proposal is not a regular file")
        data = fh.read(262145)
    if len(data) > 262144:
        raise Refuse("proposal file too large")
    try:
        p = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Refuse("proposal is not JSON")  # never echo the content: this runs as root on any path
    if not isinstance(p, dict):
        raise Refuse("proposal is not a JSON object")
    return p


def check_shape(p):
    if p.get("kind") != "proposal":
        raise Refuse("kind is not 'proposal'")
    if p.get("root") is not True:
        raise Refuse("proposal is not marked root")
    for k in ("id", "requester", "summary", "why", "command", "verify", "nonce"):
        if not isinstance(p.get(k), str) or not p[k].strip():
            raise Refuse(f"{k} missing")
    if not ID_RE.fullmatch(p["id"]) or not NONCE_RE.fullmatch(p["nonce"]):
        raise Refuse("bad id or nonce")
    if "\n" in p["command"] or "\r" in p["command"]:
        raise Refuse("command contains a newline")
    a = p.get("assertion")
    if not isinstance(a, dict):
        raise Refuse("no owner assertion (not approved by passkey)")
    for k in ("rawId", "clientDataJSON", "authenticatorData", "signature"):
        if not isinstance(a.get(k), str) or not a[k]:
            raise Refuse(f"assertion.{k} missing")
    return a


def verify(p, a, cfg):
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.asymmetric import ec

    if not hmac.compare_digest(b64d(a["rawId"], "rawId"), b64d(cfg["cred_id"], "cred_id")):
        raise Refuse("assertion is from an unknown credential")
    cdj = b64d(a["clientDataJSON"], "clientDataJSON")
    ad = b64d(a["authenticatorData"], "authenticatorData")
    sig = b64d(a["signature"], "signature")
    try:
        cd = json.loads(cdj.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Refuse("clientDataJSON is not JSON")
    if not isinstance(cd, dict) or cd.get("type") != "webauthn.get":
        raise Refuse("clientData.type is not webauthn.get")
    if not hmac.compare_digest(b64d(cd.get("challenge"), "clientData.challenge"), sha256(canonical(p))):
        raise Refuse("signature does not cover this proposal (command, verify or root flag changed)")
    if cd.get("origin") != cfg["origin"]:
        raise Refuse("clientData.origin mismatch")
    if cd.get("crossOrigin") is True:
        raise Refuse("crossOrigin assertion")
    if len(ad) < 37:
        raise Refuse("authenticatorData too short")
    if not hmac.compare_digest(ad[:32], sha256(cfg["rp_id"].encode())):
        raise Refuse("rpIdHash mismatch")
    if not ad[32] & FLAG_UP or not ad[32] & FLAG_UV:
        raise Refuse("user presence/verification flag not set")
    try:
        x, y = b64d(cfg["x"], "x"), b64d(cfg["y"], "y")
        pub = ec.EllipticCurvePublicNumbers(int.from_bytes(x, "big"), int.from_bytes(y, "big"),
                                            ec.SECP256R1()).public_key()
    except ValueError:
        raise Refuse("owner key is not a P-256 point")
    try:
        pub.verify(sig, ad + sha256(cdj), ec.ECDSA(hashes.SHA256()))
    except (InvalidSignature, ValueError):
        raise Refuse("bad signature")


def claim_once(used_dir, strict, key):
    """Record id:nonce in the used list; refuse if it is already there. Done after verification, before running."""
    try:
        trusted_file(used_dir, strict, want_dir=True)
    except FileNotFoundError:
        raise Refuse(f"{used_dir} missing (run install.sh)")
    if strict and os.lstat(used_dir).st_mode & 0o077:
        raise Refuse(f"{used_dir} must be mode 0700")
    path = os.path.join(used_dir, "used")
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.seek(0)
        if key in {line.strip() for line in fh}:
            raise Refuse("replay: this approval was already used")
        fh.write(key + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def log_line(path, rec):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write(json.dumps({"ts": now(), **rec}, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"resident-root-apply: cannot write log {path}: {e}", file=sys.stderr)


def run(command):
    # The helper's own files stay 077; the approved command gets the ordinary root umask, so config files it
    # writes are readable like any other (a 0600 apt.conf.d drop-in breaks every unprivileged apt command).
    old = os.umask(0o022)
    try:
        proc = subprocess.Popen(["/bin/sh", "-c", command], env=CLEAN_ENV, cwd="/", stdin=subprocess.DEVNULL,
                                start_new_session=True)  # stdout/stderr stream straight through
    finally:
        os.umask(old)
    try:
        return proc.wait(timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        print(f"resident-root-apply: command timed out after {TIMEOUT}s and was killed", file=sys.stderr)
        return 124


def main(argv):
    os.umask(0o077)
    args = list(argv)
    selftest = None
    if args[:1] == ["--selftest-config"]:
        if len(args) < 2:
            print(__doc__, file=sys.stderr)
            return 2
        selftest, args = args[1], args[2:]
    if len(args) != 1 or args[0].startswith("-"):
        print(__doc__, file=sys.stderr)
        return 2
    euid = os.geteuid()
    if selftest is not None:
        if euid == 0:
            print("resident-root-apply: REFUSED: --selftest-config is not allowed as root", file=sys.stderr)
            return REFUSED
        cfg_path, used_dir, log_path, strict = (os.path.join(selftest, "owner.json"), os.path.join(selftest, "used.d"),
                                                os.path.join(selftest, "root.log"), False)
    else:
        if euid != 0:
            print("resident-root-apply: REFUSED: must run as root (sudo -n)", file=sys.stderr)
            return REFUSED
        cfg_path, used_dir, log_path, strict = CONFIG, USED_DIR, LOG, True
    rec = {"proposal": os.path.abspath(args[0]), "sudo_user": os.environ.get("SUDO_USER", "")}
    try:
        cfg = load_config(cfg_path, strict)
        p = load_proposal(args[0])
        a = check_shape(p)
        rec.update(id=p["id"], summary=p["summary"][:80],
                   command_sha256=hashlib.sha256(p["command"].encode("utf-8")).hexdigest()[:16])
        verify(p, a, cfg)
        claim_once(used_dir, strict, f"{p['id']}:{p['nonce']}")
    except Refuse as e:
        print(f"resident-root-apply: REFUSED: {e}", file=sys.stderr)
        log_line(log_path, {**rec, "result": "refused", "reason": str(e)})
        return REFUSED
    print(f"resident-root-apply: proposal {p['id']} verified (owner passkey); running as "
          f"{'root' if euid == 0 else 'uid ' + str(euid) + ' (selftest)'}: {p['command']}", file=sys.stderr, flush=True)
    rc = run(p["command"])
    log_line(log_path, {**rec, "result": "ran", "exit": rc})
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
